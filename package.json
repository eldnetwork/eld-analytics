{
  "name": "eld-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Eld cluster disk analytics dashboard (Vite + React)",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldnetwork/eld-analytics.git"
  },
  "author": "Eld",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run format:check && npm run lint && npm test && npm audit --omit=dev --audit-level=high && npm run build"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.0.5"
  }
}
